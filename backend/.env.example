# DeepSeek API 密钥（必填）
DEEPSEEK_API_KEY=sk-your-key-here

# DeepSeek API 地址
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 模型名称
DEEPSEEK_MODEL=deepseek-v4-flash

# 服务监听
HOST=127.0.0.1
PORT=8000

# CORS 允许的前端来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173,https://wangyulong.top,https://www.wangyulong.top
