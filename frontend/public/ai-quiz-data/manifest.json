  "language": "zh",
  "title": "AI 应用能力测评",
  "dimensions": [
    {
      "id": "model-basics",
      "title": "模型与 AI 基础",
      "tagline": "LLM 能力、上下文、Token、幻觉、推理限制、适用边界",
      "icon": "microchip",
      "weight": 0.15,
      "advice": "重点理解模型能做什么的边界，而非只背模型是什么。建议从上下文窗口限制、幻觉不可消除、概率性输出的置信度三个方向入手。",
      "resources": [
        {
          "title": "OpenAI Prompt Engineering Guide",
          "url": "https://platform.openai.com/docs/guides/prompt-engineering"
        }
      ]
    },
    {
      "id": "prompt-context",
      "title": "Prompt / Context Engineering",
      "tagline": "指令设计、结构化输出、上下文组织、约束、任务拆解",
      "icon": "code",
      "weight": 0.15,
      "advice": "从写提示词转向设计上下文结构。重点关注系统消息与用户消息分工、示例格式一致性、长上下文信息丢失和结构化输出约束。",
      "resources": [
        {
          "title": "OpenAI Structured Outputs",
          "url": "https://platform.openai.com/docs/guides/structured-outputs"
        }
      ]
    },
    {
      "id": "rag",
      "title": "RAG 与知识增强",
      "tagline": "Embedding、检索、chunk、召回、rerank、grounding、时效",
      "icon": "book",
      "weight": 0.15,
      "advice": "关注检索到生成之间的信息损耗。建议搭建一个最小 RAG 系统，分别测试不同 Chunk 大小和 Top-K 配置下的答案准确率。",
      "resources": [
        {
          "title": "Retrieval-Augmented Generation Paper",
          "url": "https://arxiv.org/abs/2005.11401"
        }
      ]
    },
    {
      "id": "agent",
      "title": "Agent 与工作流编排",
      "tagline": "规划、工具使用、状态、循环、workflow、multi-agent、human-in-the-loop",
      "icon": "target",
      "weight": 0.2,
      "advice": "从调用工具升级到管理状态。重点学习规划模式的边界、工具失败回退、多 Agent 通信权限，以及人工介入时机。",
      "resources": [
        {
          "title": "ReAct Paper",
          "url": "https://arxiv.org/abs/2210.03629"
        }
      ]
    },
    {
      "id": "tools-skills-mcp",
      "title": "Tools / Skills / MCP",
      "tagline": "function calling、Skill 封装、stateless MCP、Agent Plugins",
      "icon": "wrench",
      "weight": 0.2,
      "advice": "把工具当作接口契约而非黑盒。重点理解 Function Calling Schema、MCP stateless 状态迁移、Skill 渐进式披露和 Agent Plugins 复用机制。",
      "resources": [
        {
          "title": "MCP 2026-07-28 Specification",
          "url": "https://modelcontextprotocol.io/specification/2026-07-28"
        }
      ]
    },
    {
      "id": "eval-safety",
      "title": "Eval / Safety / Reliability",
      "tagline": "OWASP Agentic ASI01-ASI10、权限、工具滥用、评测",
      "icon": "shield-03",
      "weight": 0.15,
      "advice": "建立攻击者视角。重点学习 Goal Hijack、Tool Misuse、Memory Poisoning、输出验证和供应链攻击在 Skill / MCP 插件中的表现。",
      "resources": [
        {
          "title": "OWASP Agentic Top 10 2026",
          "url": "https://genai.owasp.org/resource/owasp-top-10-for-agentic-applications-for-2026/"
        }
      ]
    }
  ],
